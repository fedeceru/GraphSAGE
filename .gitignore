# Custom
*.idea
*.png
*.pdf
tmp/
*.txt
*swp*
*.sw?
gcn_back
.DS_STORE
*.aux
*.log
*.out
*.bbl
*.synctex.gz

# Deliverables that would otherwise be caught by the broad patterns above
!GraphSAGE.pdf
!requirements.txt

# Project env / data / experiment outputs
.venv/
data/
logs/
sup-*/
unsup-*/
checkpoints/
.ipynb_checkpoints/

# results/ is regenerated by running the reproduction pipeline (see README.md)
# -- nothing under it is tracked except this placeholder, so a fresh clone
# starts empty, same as data/ and logs/ above.
results/*
!results/.gitkeep

# Personal exam/presentation prep notes -- not a project deliverable
STUDY_GUIDE.md
EXAM_STUDY_GUIDE.md
presentation_script.md
presentation/presentation_script.md
learning_material/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env

# virtualenv
venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

*.pickle
*.pkl

*.claude
